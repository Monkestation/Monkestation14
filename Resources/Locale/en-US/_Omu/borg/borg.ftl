borg-type-medical_kerfo-transponder = medical cyborg

borg-type-service_kerfo-name = Service
borg-type-service_kerfo-desc = Help out with a wide range of crew services, ranging from serving snacks and drinks to botany to entertainment.
borg-type-service_kerfo-transponder = service cyborg